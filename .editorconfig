# Hand-written Java in this project is indented with tabs.
# See CLAUDE.md. Do not reformat existing files wholesale - it destroys git blame.
root = true

[*]
charset = utf-8
trim_trailing_whitespace = false
insert_final_newline = false

[*.java]
indent_style = tab
indent_size = 4

# Generated by JFlex, formatted by the generator - leave it alone.
[src/main/java/org/json/simple/parser/Yylex.java]
indent_style = space
indent_size = 2

[*.{xml,yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
